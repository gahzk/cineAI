# ============================================================
# CineAI Backend — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Nunca faça commit do .env em controle de versão.
# ============================================================

# --- TMDB ---
# Obtenha um Bearer Token v4 grátis em:
# https://www.themoviedb.org/settings/api
TMDB_BEARER_TOKEN="your-tmdb-v4-read-access-token"

# --- Banco de dados ---
# SQLite local (padrão para desenvolvimento):
DATABASE_URL=sqlite+aiosqlite:///./cineai.db

# Para produção em Postgres/Supabase, troque por:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db?ssl=require

# --- Auth ---
# Gere uma chave forte com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# Como o JWT vai no header Authorization (não em cookie),
# allow_credentials está desativado no main.py — então "*" funciona.
CORS_ORIGINS=["*"]

# --- Catálogo TMDB ---
CATALOG_TARGET=2500
CACHE_EXPIRATION_DAYS=7
