# Copie para backend/.env e preencha. Nunca faça commit do .env.

# Obrigatório: token de leitura (v4) do TMDB — https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# Obrigatório: chave para assinar os logins. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional: banco (padrão: arquivo SQLite cineai.db na pasta backend)
# DATABASE_URL=sqlite:///./cineai.db

# Opcional: liga a busca por texto livre ("um suspense curto dos anos 90")
# ANTHROPIC_API_KEY=
# CINEAI_MODEL=claude-opus-5-5

# Opcional: dias até o login expirar (padrão 7)
# TOKEN_DAYS=7
