# ============================================================
# CineAI Backend - Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ============================================================

# --- TMDB ---
# Prefer the v4 API Read Access Token:
TMDB_BEARER_TOKEN="your-tmdb-v4-read-access-token"
#
# Or use the shorter v3 API key instead:
# TMDB_API_KEY="your-tmdb-v3-api-key"

# --- Database ---
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./cineai.db

# Supabase Postgres (recommended for this project):
# 1. Supabase Dashboard > Connect
# 2. Copy either "Session pooler" or "Direct connection"
# 3. Replace postgres:// or postgresql:// with postgresql+asyncpg://
#
# Session pooler example, best when your network/app needs IPv4:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
#
# Direct connection example, best for long-running servers with IPv6:
# DATABASE_URL=postgresql+asyncpg://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require
#
# Transaction pooler example, only if you specifically need port 6543:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
# DB_DISABLE_PREPARED_STATEMENT_CACHE=true

# Optional database tuning
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_DISABLE_PREPARED_STATEMENT_CACHE=false

# --- Auth ---
# Generate a strong secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- Catalog ---
CATALOG_TARGET=2500
CACHE_EXPIRATION_DAYS=7
